extends layout

block content
  h1= title

  - image_names = ["pic1.jpg", "pic2.jpg", "pic3.jpg", "pic4.jpg", "pic5.jpg"]
  - for (let i = 0; i < 3; i++){
      - let pick = image_names[Number(Math.floor(Math.random()*5))]
      img(src=`/images/${pick}` alt=`${pick}` width="300" height="300")
  - }